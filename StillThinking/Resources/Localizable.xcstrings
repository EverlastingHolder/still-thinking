    "onboarding.reflect.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays local on this device, and a returned thought can be completed or postponed again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные остаются локально на устройстве, а возвращённую мысль можно завершить или отложить снова."
          }
        }
      }
    },
