    "onboarding.capture.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still Thinking is for ideas, doubts, and questions that are better revisited later."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still Thinking подходит для идей, сомнений и вопросов, к которым лучше вернуться позже."
          }
        }
      }
    },
    "onboarding.capture.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture an unfinished thought"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите незавершённую мысль"
          }
        }
      }
    },
    "onboarding.reflect.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays local on this device, and a returned thought can be completed or postponed again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные остаются локально на устройстве, а возвращённую мысль можно завершить или отложить снова."
          }
        }
      }
    },
    "onboarding.reflect.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflect or let it go"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте или отпустите"
          }
        }
      }
    },
    "onboarding.return.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The thought appears again in Today. By default, notifications do not reveal private text."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мысль появится снова в Today. Уведомление по умолчанию не раскрывает приватный текст."
          }
        }
      }
    },
